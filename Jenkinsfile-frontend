pipeline {
    agent any
    tools {
        nodejs 'node18'
    }
    stages {
        stage('拉取代码') {
            steps {
                git url: 'https://gitee.com/belong_wx/hxs-lite.git',
                    branch: 'main',
                    credentialsId: 'gitee-auth'
            }
        }
        stage('前端依赖安装&打包') {
            steps {
                sh '''
cd hxs-frontend
npm install
npm run build
'''
            }
        }
        stage('构建前端Nginx镜像') {
            steps {
                sh '''
cd hxs-frontend
docker build -t hxs-lite-front:latest .
'''
            }
        }
        stage('部署前端容器') {
            steps {
                sh '''
# 停止并删除旧容器
docker stop hxs-lite-front 2>/dev/null || true
docker rm hxs-lite-front 2>/dev/null || true

# 启动新容器
docker run -d --name hxs-lite-front -p 127.0.0.1:8081:80 hxs-lite-front:latest
'''
            }
        }
    }
}

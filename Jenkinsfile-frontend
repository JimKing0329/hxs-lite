pipeline {
    agent any
    tools {
        nodejs 'node18'
    }
    stages {
        stage('拉取代码') {
            steps {
                git url: 'https://gitee.com/belong_wx/river-lion.git',
                    branch: 'main',
                    credentialsId: 'gitee-auth'
            }
        }
        stage('前端依赖安装&打包') {
            steps {
                sh '''
cd hxs-frontend
npm install
npm run build
'''
            }
        }
        stage('构建前端Nginx镜像') {
            steps {
                sh '''
cd hxs-frontend
docker build -t river-lion-front:latest .
'''
            }
        }
        stage('部署前端容器') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'server-root', passwordVariable: 'SSH_PWD', usernameVariable: 'SSH_USER')]) {
                    sshPublisher(publishers: [sshPublisherDesc(
                        sshHost: '填写你的服务器公网IP',
                        sshPort: 22,
                        sshCredentials: sshCredentials(username: "${SSH_USER}", password: "${SSH_PWD}"),
                        transfers: [sshTransfer(
                            postTransfers: [postTransfer(postTransferAction: command('''
docker stop river-lion-front 2>/dev/null || true
docker rm river-lion-front 2>/dev/null || true
docker run -d --name river-lion-front -p 127.0.0.1:8081:80 river-lion-front:latest
'''))]
                        )]
                    )])
                }
            }
        }
    }
}

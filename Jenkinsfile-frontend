pipeline {
    agent any
    tools {
        nodejs 'node18'
    }
    stages {
        stage('拉取代码') {
            steps {
                git url: 'https://gitee.com/belong_wx/hxs-lite.git',
                    branch: 'main',
                    credentialsId: 'gitee-auth'
            }
        }
        stage('前端依赖安装&打包') {
            steps {
                sh '''
cd hxs-frontend
export NODE_OPTIONS="--max-old-space-size=1024"
npm install
npm run build
'''
            }
        }
        stage('构建前端Nginx镜像') {
            steps {
                sh '''
cd hxs-frontend
docker build -t hxs-lite-front:latest .
'''
            }
        }
        stage('部署前端容器') {
            steps {
                sh '''
# 停止并删除旧容器
docker stop hxs-lite-front 2>/dev/null || true
docker rm hxs-lite-front 2>/dev/null || true

# 启动新容器（不对外暴露端口，只通过 Docker 内部网络给 Nginx 访问）
docker run -d --name hxs-lite-front --network hxs-net hxs-lite-front:latest
'''
            }
        }
    }
}

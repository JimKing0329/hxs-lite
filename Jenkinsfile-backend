pipeline {
    agent any
    tools {
        jdk 'jdk17'
        maven 'maven3'
    }
    stages {
        stage('拉取Gitee源码') {
            steps {
                git url: 'https://gitee.com/belong_wx/hxs-lite.git',
                    branch: 'main',
                    credentialsId: 'gitee-auth'
            }
        }
        stage('后端Maven打包') {
            steps {
                sh '''
cd hxs-backend
mvn clean package -Dmaven.test.skip=true
'''
            }
        }
        stage('构建后端Docker镜像') {
            steps {
                sh '''
cd hxs-backend
docker build -t hxs-lite-back:latest .
'''
            }
        }
        stage('部署后端容器') {
            steps {
                sh '''
# 停止并删除旧容器
docker stop hxs-lite-back 2>/dev/null || true
docker rm hxs-lite-back 2>/dev/null || true

# 启动新容器
docker run -d \\
  --name hxs-lite-back \\
  --network hxs-net \\
  -p 127.0.0.1:8082:8080 \\
  -e SPRING_DATASOURCE_URL='jdbc:mysql://mysql57:3306/hxs?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai' \\
  -e SPRING_DATASOURCE_USERNAME='hxs' \\
  -e SPRING_DATASOURCE_PASSWORD='XFRBS8iwFL3Rz5Tf' \\
  hxs-lite-back:latest
'''
            }
        }
    }
}

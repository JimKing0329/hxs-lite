pipeline {
    agent any
    tools {
        jdk 'jdk17'
        maven 'maven3'
    }
    stages {
        stage('拉取Gitee源码') {
            steps {
                git url: 'https://gitee.com/belong_wx/river-lion.git',
                    branch: 'main',
                    credentialsId: 'gitee-auth'
            }
        }
        stage('后端Maven打包') {
            steps {
                sh '''
cd hxs-backend
mvn clean package -Dmaven.test.skip=true
'''
            }
        }
        stage('构建后端Docker镜像') {
            steps {
                sh '''
cd hxs-backend
docker build -t river-lion-back:latest .
'''
            }
        }
        stage('远程部署后端容器') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'server-root', passwordVariable: 'SSH_PWD', usernameVariable: 'SSH_USER')]) {
                    sshPublisher(publishers: [sshPublisherDesc(
                        sshHost: '填写你的服务器公网IP',
                        sshPort: 22,
                        sshCredentials: sshCredentials(username: "${SSH_USER}", password: "${SSH_PWD}"),
                        transfers: [sshTransfer(
                            postTransfers: [postTransfer(postTransferAction: command('''
docker stop river-lion-back 2>/dev/null || true
docker rm river-lion-back 2>/dev/null || true
docker run -d \
--name river-lion-back \
-p 127.0.0.1:8080:8080 \
--link mysql57:mysql \
-e SPRING_DATASOURCE_URL="jdbc:mysql://mysql:3306/hxs?useUnicode=true&characterEncoding=utf8mb4&serverTimezone=Asia/Shanghai" \
-e SPRING_DATASOURCE_USERNAME="hxs" \
-e SPRING_DATASOURCE_PASSWORD="XFRBS8iwFL3Rz5Tf" \
river-lion-back:latest
'''))]
                        )]
                    )])
                }
            }
        }
    }
}

pipeline {
    agent any
    tools {
        jdk 'jdk17'
        maven 'maven3'
    }
    stages {
        stage('拉取Gitee源码') {
            steps {
                git url: 'https://gitee.com/belong_wx/hxs-lite.git',
                    branch: 'main',
                    credentialsId: 'gitee-auth'
            }
        }
        stage('后端Maven打包') {
            steps {
                sh '''
cd hxs-backend
mvn clean package -Dmaven.test.skip=true
'''
            }
        }
        stage('构建后端Docker镜像') {
            steps {
                sh '''
cd hxs-backend
docker build -t hxs-lite-back:latest .
'''
            }
        }
        stage('部署后端容器') {
            steps {
                withCredentials([
                    string(credentialsId: 'hxs-db-password', variable: 'DB_PWD'),
                    string(credentialsId: 'hxs-wechat-app-id', variable: 'WX_APP_ID'),
                    string(credentialsId: 'hxs-wechat-app-secret', variable: 'WX_APP_SECRET'),
                    string(credentialsId: 'hxs-admin-sid', variable: 'ADMIN_SID'),
                    string(credentialsId: 'hxs-admin-pwd', variable: 'ADMIN_PWD'),
                    string(credentialsId: 'hxs-jwt-admin-secret', variable: 'JWT_ADMIN_SECRET'),
                    string(credentialsId: 'hxs-jwt-user-secret', variable: 'JWT_USER_SECRET')
                ]) {
                    sh '''
# 停止并删除旧容器
docker stop hxs-lite-back 2>/dev/null || true
docker rm hxs-lite-back 2>/dev/null || true

# 启动新容器（敏感信息从 Jenkins 凭据读取，不写入代码）
docker run -d \\
  --name hxs-lite-back \\
  --network hxs-net \\
  -p 127.0.0.1:8082:8080 \\
  -v /data/hxs-lite-back/secret/secret.key:/app/secret.key \\
  -e HXS_DATASOURCE_URL='jdbc:mysql://mysql57:3306/hxs?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai' \\
  -e HXS_DATASOURCE_USERNAME='hxs' \\
  -e HXS_DATASOURCE_PASSWORD="$DB_PWD" \\
  -e HXS_WECHAT_APP_ID="$WX_APP_ID" \\
  -e HXS_WECHAT_APP_SECRET="$WX_APP_SECRET" \\
  -e HXS_BASE_URL='http://82.156.49.70' \\
  -e HXS_COURSE_URL='http://82.156.49.70:18081' \\
  -e HXS_ADMIN_SID="$ADMIN_SID" \\
  -e HXS_ADMIN_PWD="$ADMIN_PWD" \\
  -e HXS_JWT_ADMIN_SECRET="$JWT_ADMIN_SECRET" \\
  -e HXS_JWT_USER_SECRET="$JWT_USER_SECRET" \\
  hxs-lite-back:latest
'''
                }
            }
        }
    }
}
